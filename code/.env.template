# 项目环境变量：按需填写所运行章节需要的配置。
# 调用 load_dotenv() 的脚本可向上查找并加载此文件。
# 未调用 load_dotenv() 的脚本，请在 code 目录先执行：
# set -a; source .env; set +a
# 密钥留空表示尚未配置；请勿将真实密钥提交到 Git。

# DeepSeek：C1、C3、C4、C5、C6 的相关示例
DEEPSEEK_API_KEY=

# Moonshot：C8、C9 的生成模块
MOONSHOT_API_KEY=

# Kimi：C9/agent(代码系ai生成)/run_ai_agent.py
# 与 MOONSHOT_API_KEY 分别读取，如使用同一账号可填写相同密钥。
KIMI_API_KEY=

# OpenAI / Tavily：C7/agentic_rag；Tavily 为可选网页搜索
OPENAI_API_KEY=
TAVILY_API_KEY=

# PowerRAG / RAGFlow：Extra-chapter/PowerRAG-SDK-Text-QA
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_NAME=powerrag_text_qa_demo
# 留空使用租户默认 embedding 模型；格式为 <model>@<factory>
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_TOP_K=5
RAGFLOW_CANDIDATE_K=1024
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3
RAGFLOW_KEYWORD=false

# RAGFlow CLI 兼容别名，优先使用上面的 RAGFLOW_* 配置。
# RAGFLOW_BASE_URL 有非空默认值，URL 别名通常不会生效。
# POWERRAG_BASE_URL=
# POWERRAG_API_KEY=
# BASE_URL=
# API_KEY=

# Docker Compose：code/docker-compose.yml，默认相对于 Compose 项目目录。
# 在 code 目录执行，Compose 会自动读取同目录 .env：
# docker compose up -d
DOCKER_VOLUME_DIRECTORY=.

# 可选：文档示例中的 Hugging Face 镜像地址。
# HF_ENDPOINT=https://hf-mirror.com

# Visual BGE 底层开关：通常保持注释，交由代码控制。
# ENV_TYPE=deepspeed
# RoPE=1
# tokenizer.py 已在代码中设置 TOKENIZERS_PARALLELISM=false。
# TOKENIZERS_PARALLELISM=false

# 扩展章节 README 的 embedding API 配置命令使用，Python 不直接读取。
# EMB_FACTORY=
# EMB_MODEL=
# EMB_API_BASE=
# EMB_API_KEY=

# 注意：Ollama 模型名及部分服务连接信息目前写在代码/配置文件中，
# 在此新增同名变量不会自动覆盖它们。
